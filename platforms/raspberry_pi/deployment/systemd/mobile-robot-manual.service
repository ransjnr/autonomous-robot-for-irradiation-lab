[Unit]
Description=Mobile robot manual-control ROS services
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot
WorkingDirectory=/home/robot/mobile_robot_stack/ros2_ws
Environment=ROS_DOMAIN_ID=20
ExecStart=/bin/bash -lc 'source /opt/ros/$ROS_DISTRO/setup.bash && source install/setup.bash && ros2 launch mobile_robot_bringup manual_control.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
